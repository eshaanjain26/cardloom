# Copy to .env.local. Every variable is optional.

# Where the server reaches Ollama for local, offline models.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Let users who leave the API key empty in Settings use the keys below.
# Anyone who can reach this server can then spend them, so only enable this
# on a private deployment.
# CARDLOOM_SERVER_KEYS=1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
